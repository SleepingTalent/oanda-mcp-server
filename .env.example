# OANDA V20 API credentials
# Copy this file to .env and fill in your values
# NEVER commit .env to version control

# Required: Your OANDA personal access token
OANDA_API_KEY=your-oanda-api-key-here

# Required: Your OANDA account ID (format: 001-001-XXXXXXXX-001)
OANDA_ACCOUNT_ID=your-account-id-here

# Optional: Target environment — "practice" (default) or "live"
# WARNING: setting this to "live" will use real money
OANDA_ENVIRONMENT=practice

# Optional: Port the MCP server listens on (default: 8000)
MCP_PORT=8000
