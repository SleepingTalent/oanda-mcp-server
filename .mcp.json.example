{
  "mcpServers": {
    "oanda-mcp": {
      "type": "stdio",
      "command": "docker",
      "args": [
        "run", "--rm", "-i",
        "--env", "OANDA_API_KEY",
        "--env", "OANDA_ACCOUNT_ID",
        "--env", "OANDA_ENVIRONMENT",
        "yourdockerhubuser/oanda-mcp-server:latest"
      ],
      "env": {
        "OANDA_API_KEY": "your-oanda-api-key-here",
        "OANDA_ACCOUNT_ID": "your-oanda-account-id-here",
        "OANDA_ENVIRONMENT": "practice"
      }
    },
    "brave-search": {
      "type": "stdio",
      "command": "/opt/homebrew/bin/npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-brave-search"
      ],
      "env": {
        "BRAVE_API_KEY": "your-brave-api-key-here"
      }
    },
    "context7": {
      "type": "stdio",
      "command": "/opt/homebrew/bin/npx",
      "args": [
        "-y",
        "@upstash/context7-mcp"
      ]
    },
    "docker": {
      "type": "stdio",
      "command": "/opt/homebrew/bin/uvx",
      "args": [
        "docker-mcp"
      ]
    },
    "fetch": {
      "type": "stdio",
      "command": "/opt/homebrew/bin/uvx",
      "args": [
        "mcp-server-fetch"
      ]
    },
    "memory": {
      "type": "stdio",
      "command": "/opt/homebrew/bin/npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-memory"
      ]
    },
    "playwright": {
      "type": "stdio",
      "command": "/opt/homebrew/bin/npx",
      "args": [
        "-y",
        "@playwright/mcp@latest"
      ]
    },
    "github": {
      "type": "stdio",
      "command": "/opt/homebrew/bin/npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-github"
      ],
      "env": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "your-github-pat-here"
      }
    },
    "alphavantage": {
      "type": "stdio",
      "command": "/opt/homebrew/bin/uvx",
      "args": ["--from", "marketdata-mcp-server", "marketdata-mcp", "your-alphavantage-api-key-here"],
      "env": {}
    }
  }
}
